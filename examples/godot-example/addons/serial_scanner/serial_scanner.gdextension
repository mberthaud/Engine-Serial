[configuration]

entry_symbol = "serial_scanner_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

macos.debug = "./bin/serial_scanner.macos.template_debug.universal.dylib"
macos.release = "./bin/serial_scanner.macos.template_release.universal.dylib"
windows.debug.x86_64 = "./bin/serial_scanner.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/serial_scanner.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/serial_scanner.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/serial_scanner.linux.template_release.x86_64.so"
linux.debug.arm64 = "./bin/serial_scanner.linux.template_debug.arm64.so"
linux.release.arm64 = "./bin/serial_scanner.linux.template_release.arm64.so"
